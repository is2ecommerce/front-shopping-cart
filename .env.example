# Configuración del Frontend Angular - Shopping Cart

# URL base del API del backend (Spring Boot)
# Desarrollo: http://localhost:8080/shopping-cart/api
# Producción: Actualizar con la URL real del gateway Keycloak
API_URL=http://localhost:8080/shopping-cart/api

# Puerto del servidor de desarrollo Angular
PORT=4200

# Configuración de Keycloak (cuando esté integrado)
# KEYCLOAK_URL=http://localhost:8080/auth
# KEYCLOAK_REALM=ecommerce
# KEYCLOAK_CLIENT_ID=shopping-cart-frontend

# Notas:
# - Keycloak manejará la autenticación y autorizará las peticiones
# - No se requiere configurar tokens JWT manualmente
# - El backend está configurado en puerto 8080 por defecto
# - Si Keycloak usa puerto 8080, cambiar backend a 8081
